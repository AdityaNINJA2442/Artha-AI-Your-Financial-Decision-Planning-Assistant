# Environment Variables for Artha AI Backend

# Application Settings
PROJECT_NAME="Artha AI"
API_V1_STR="/api/v1"
SECRET_KEY="artha_ai_super_secret_jwt_key_change_in_production_32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (PostgreSQL 16)
DATABASE_URL="postgresql://artha_user:artha_password@localhost:5432/artha_db"

# Optional External API Keys (Graceful fallbacks implemented)
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
MARKET_API_KEY=""
OCR_API_KEY=""

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
